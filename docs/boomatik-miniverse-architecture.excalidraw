      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 533985411,
      "version": 1,
      "versionNonce": 411436545,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782824332928,
      "link": null,
      "locked": false,
      "text": "Nota de alcance honesta: proyecto pequeno y local. Sin BD, ORM, migraciones,\ncolas ni llamadas a LLM dentro del repo. El front Vite consume una API REST\nlocal de @miniverse/server. Los 5 citizens (tema \"BOO FC stadium\") muestran\nel estado de los agentes BOO; quien lo actualiza es Claude Code via hooks.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nota de alcance honesta: proyecto pequeno y local. Sin BD, ORM, migraciones,\ncolas ni llamadas a LLM dentro del repo. El front Vite consume una API REST\nlocal de @miniverse/server. Los 5 citizens (tema \"BOO FC stadium\") muestran\nel estado de los agentes BOO; quien lo actualiza es Claude Code via hooks.",
      "lineHeight": 1.25,
      "baseline": 12
    },
    {
      "id": "txt-72d8567d",
      "type": "text",
      "x": 40,
      "y": 770,
      "width": 540,
      "height": 27.5,
      "angle": 0,
      "strokeColor": "#8B5CF6",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],

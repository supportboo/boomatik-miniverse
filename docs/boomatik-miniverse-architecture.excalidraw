    {
      "id": "txt-dc96925e",
      "type": "text",
      "x": 40,
      "y": 680,
      "width": 540,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#52525b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

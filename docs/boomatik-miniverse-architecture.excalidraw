      "roundness": null,
      "seed": 905983921,
      "version": 1,
      "versionNonce": 394037564,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782824332928,
      "link": null,
      "locked": false,
      "text": "Modelos: ninguno fijado en runtime. 'claude-opus' solo aparece como ID de\nagente en el README; los agentes los dirige Claude Code (externo), no el repo.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Modelos: ninguno fijado en runtime. 'claude-opus' solo aparece como ID de\nagente en el README; los agentes los dirige Claude Code (externo), no el repo.",
